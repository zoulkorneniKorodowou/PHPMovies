          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tous les films sont dans la catégorie action\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    body.data.forEach(function (movie) {",
                  "        pm.expect(movie.category_slug).to.eql(\"action\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
